# all keys are optional. anything left blank is skipped and the scan still runs
FINNHUB_KEY=
ALPHA_VANTAGE_KEY=
FRED_KEY=
NEWSAPI_KEY=

# any LiteLLM model string. set to "none" to run on rules only
LLM_MODEL=ollama/llama3.2:3b

# run scans automatically in the premarket, post-market and night windows
SCHEDULER_ENABLED=false
DEFAULT_STRATEGY=Small Cap Momentum
